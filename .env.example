# Copy this file to ".env" (same folder) and fill in what you need. Never commit ".env".
# Windows (Command Prompt):  copy .env.example .env

# --- Recommended -----------------------------------------------------------
# GitHub personal access token. Without it GitHub allows only 60 API requests/hour,
# which is about 2-3 investigations. With it you get 5,000/hour and deeper history scans.
# Create one at https://github.com/settings/tokens (a fine-grained token with read-only
# access to PUBLIC repositories is enough; no special permissions needed).
GITHUB_TOKEN=

# --- Optional --------------------------------------------------------------
# Enables AI-written hypotheses (always labelled "AI-generated, unverified" in the UI).
# Leave blank and TraceLens uses deterministic rule-based hypotheses instead.
ANTHROPIC_API_KEY=
# Model used for hypotheses. Default: claude-sonnet-5-5
ANTHROPIC_MODEL=

# Port for the local web server (default 3000)
PORT=3000

# Testing only: point at a fake GitHub API. Leave blank for the real one.
GITHUB_API_URL=
